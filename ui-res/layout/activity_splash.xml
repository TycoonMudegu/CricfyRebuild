<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ui_background" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@id/ly_splash" android:orientation="vertical" android:gravity="center"
        android:paddingStart="32dp" android:paddingEnd="32dp" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@id/splash_img" android:layout_width="104dp" android:layout_height="104dp"
            android:scaleType="fitCenter" android:contentDescription="@string/app_name" app:srcCompat="@drawable/ui_preview_logo" />
        <TextView android:text="@string/app_name" android:fontFamily="@font/ui_inter_semibold" android:textSize="30sp"
            android:textColor="@color/ui_text" android:includeFontPadding="false" android:letterSpacing="-0.025"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
        <TextView android:text="@string/ui_splash_subtitle" android:fontFamily="@font/ui_inter_regular" android:textSize="15sp"
            android:textColor="@color/ui_text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
        <com.airbnb.lottie.LottieAnimationView android:id="@id/anim_splash" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginTop="32dp" app:lottie_autoPlay="true" app:lottie_loop="true" app:lottie_rawRes="@raw/loading_anim" />
        <LinearLayout android:id="@id/ly_offline" android:visibility="gone" android:orientation="horizontal" android:gravity="center"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp">
            <com.google.android.material.button.MaterialButton android:id="@id/wifi_setting_btn" android:text="@string/open_wi_fi_setting"
                android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" style="@style/Widget.Cricfy.Ui.NavigationButton" />
            <com.google.android.material.button.MaterialButton android:id="@id/mobile_data_btn" android:text="@string/open_mobile_data"
                android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" style="@style/Widget.Cricfy.Ui.NavigationButton" />
            <com.google.android.material.button.MaterialButton android:id="@id/refresh_btn" android:text="@string/refresh"
                android:layout_width="wrap_content" android:layout_height="48dp" style="@style/Widget.Cricfy.Ui.NavigationButton" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@id/version_txt" android:text="@string/version_txt" android:fontFamily="@font/ui_inter_regular"
        android:textSize="11sp" android:textColor="@color/ui_text_secondary" android:gravity="center" android:layout_alignParentBottom="true"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" />
    <include android:id="@id/error_layout" android:visibility="gone" layout="@layout/error_layout" />
    <androidx.fragment.app.FragmentContainerView android:id="@id/update_container" android:layout_width="match_parent" android:layout_height="match_parent" />
</RelativeLayout>
