<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/swipe_refresh" android:background="@color/ui_background"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@id/event_content_container" android:orientation="vertical"
            android:paddingStart="@dimen/ui_page_padding" android:paddingEnd="@dimen/ui_page_padding"
            android:clipChildren="false" android:clipToPadding="false"
            android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:text="@string/ui_home_title" android:textSize="32sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/ui_text" android:includeFontPadding="false" android:accessibilityHeading="true"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <TextView android:text="@string/ui_home_subtitle" android:textSize="14sp" android:fontFamily="sans-serif"
                android:textColor="@color/ui_text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:layout_marginBottom="18dp" />
            <include android:id="@id/home_message" layout="@layout/message_ly" />
            <TextView android:text="@string/ui_browse_sports" android:textSize="15sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/ui_text_secondary" android:accessibilityHeading="true"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@id/cats_recycler" android:orientation="horizontal"
                android:paddingTop="5dp" android:paddingBottom="5dp" android:clipToPadding="false" android:clipChildren="false"
                android:scrollbars="none" android:layout_width="match_parent" android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            <TextView android:text="@string/ui_live_upcoming" android:textSize="22sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/ui_text" android:accessibilityHeading="true"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="6dp" />
            <HorizontalScrollView android:id="@id/horizontalScrollView" android:scrollbars="none" android:clipToPadding="false"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                <com.google.android.material.chip.ChipGroup android:id="@id/events_type"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp" app:singleLine="true" app:singleSelection="true" />
            </HorizontalScrollView>
            <androidx.recyclerview.widget.RecyclerView android:id="@id/recycler" android:orientation="vertical"
                android:paddingTop="4dp" android:paddingBottom="@dimen/ui_home_bottom_inset"
                android:clipToPadding="false" android:clipChildren="false" android:scrollbars="none"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
        <TextView android:id="@id/empty_error" android:visibility="gone" android:text="@string/empty_error"
            android:textSize="16sp" android:fontFamily="sans-serif" android:textColor="@color/ui_text_secondary"
            android:gravity="center" android:padding="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <include android:id="@id/error_layout" android:visibility="gone" layout="@layout/error_layout" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
