<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Cricfy.Ui.Chip" parent="@style/TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/ui_inter_medium</item>
        <item name="fontFamily">@font/ui_inter_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ui_text_selector</item>
    </style>
    <style name="TextAppearance.Cricfy.Ui.Toolbar" parent="@style/TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/ui_text</item>
    </style>
    <style name="Widget.Cricfy.Ui.Chip" parent="@style/Widget.MaterialComponents.Chip.Choice">
        <item name="android:textAppearance">@style/TextAppearance.Cricfy.Ui.Chip</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ui_text_selector</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:soundEffectsEnabled">true</item>
        <item name="android:stateListAnimator">@animator/ui_card_motion</item>
        <item name="chipBackgroundColor">@color/ui_card_surface</item>
        <item name="chipStrokeColor">@color/ui_card_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/ui_corner_radius</item>
        <item name="chipMinHeight">44dp</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="rippleColor">@color/ui_ripple</item>
    </style>
    <style name="Widget.Cricfy.Ui.NavigationButton" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ui_text_selector</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">80dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:soundEffectsEnabled">true</item>
        <item name="android:stateListAnimator">@animator/ui_card_motion</item>
        <item name="backgroundTint">@color/ui_card_surface</item>
        <item name="cornerRadius">@dimen/ui_corner_radius</item>
        <item name="strokeColor">@color/ui_card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ui_ripple</item>
    </style>
    <style name="Animation.Cricfy.Ui.Window" parent="@android:style/Animation.Activity">
        <item name="android:windowEnterAnimation">@anim/ui_page_enter</item>
        <item name="android:windowExitAnimation">@anim/ui_page_exit</item>
    </style>
</resources>
